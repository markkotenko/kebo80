if SHIELD_DONGLE

config ZMK_KEYBOARD_NAME
    default "kebo80_dongle"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 1

config BT_MAX_CONN
    default 4

config BT_MAX_PAIRED
    default 4

config ZMK_USB
    default y

endif