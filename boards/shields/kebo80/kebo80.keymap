#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp ESC         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &kp DELETE
                &kp GRAVE       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &kp BACKSPACE
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp LBKT        &kp RBKT        &kp BACKSLASH
                &kp CAPS        &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT         &kp ENTER
                &kp LSHFT                       &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT
                &kp LCTRL       &mo 2           &kp LGUI        &kp LALT        &kp SPACE                       &kp SPACE                       &kp RALT        &kp LEFT        &kp UP          &kp DOWN        &kp RIGHT       &kp RCTRL
            >;
        };
        alternative_layer {
            bindings = <
                &kp ESC         &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp F4          &kp F5          &kp PRINTSCREEN &kp PG_UP       &kp PG_DN       &kp HOME        &kp END         &kp F11         &kp F12         &kp DELETE
                &kp GRAVE       &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp MINUS       &kp EQUAL       &kp BACKSPACE
                &kp TAB         &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y           &kp U           &kp I           &kp O           &kp P           &kp LBKT        &kp RBKT        &kp BACKSLASH
                &kp CAPS        &kp A           &kp S           &kp D           &kp F           &kp G           &kp H           &kp J           &kp K           &kp L           &kp SEMI        &kp SQT         &kp ENTER
                &kp LSHFT                       &kp Z           &kp X           &kp C           &kp V           &kp B           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &kp RSHFT
                &kp LCTRL       &mo 3           &kp LGUI        &kp LALT        &kp SPACE                       &kp SPACE                       &kp RALT        &kp LEFT        &kp UP          &kp DOWN        &kp RIGHT       &kp RCTRL
            >;
        };
        default_fn_layer {
            bindings = <
                &trans          &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp F4          &kp F5          &kp PRINTSCREEN &kp PG_UP       &kp PG_DN       &kp HOME        &kp END         &kp F11         &kp F12         &bt BT_CLR
                &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &trans          &trans          &trans          &trans          &trans          &trans          &bt BT_CLR_ALL  &trans          &trans          &trans
                &to 1           &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp INSERT      &trans          &trans          &trans          &trans          &trans
                &to 1           &trans          &ko SCROLLLOCK  &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans                          &trans          &trans          &trans          &trans          &kp PAUSE_BREAK &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &kp K_APP       &trans          &studio_unlock                  &studio_unlock                  &trans          &kp HOME        &kp PG_UP       &kp PG_DN       &kp END         &trans
            >;
        };
        alternative_fn_layer {
            bindings = <
                &trans          &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &bt BT_CLR
                &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &trans          &trans          &trans          &trans          &trans          &trans          &bt BT_CLR_ALL  &trans          &trans          &trans
                &to 0           &trans          &trans          &trans          &trans          &trans          &trans          &trans          &kp INSERT      &trans          &trans          &trans          &trans          &trans
                &to 0           &trans          &ko SCROLLLOCK  &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                &trans                          &trans          &trans          &trans          &trans          &kp PAUSE_BREAK &trans          &trans          &trans          &trans          &trans          &trans
                &trans          &trans          &kp K_APP       &trans          &studio_unlock                  &studio_unlock                  &trans          &kp HOME        &kp PG_UP       &kp PG_DN       &kp END         &trans
            >;
        };
    };
};
