#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan               = &kscan0;
        zmk,physical-layout     = &phlo0;
    };

    kscan0: kscan {
        compatible      =   "zmk,kscan-gpio-matrix";
        diode-direction =   "row2col";
        row-gpios       =   <&gpio0 8   (GPIO_ACTIVE_HIGH)>,
                            <&gpio1 0   (GPIO_ACTIVE_HIGH)>,
                            <&gpio1 6   (GPIO_ACTIVE_HIGH)>,
                            <&gpio0 10  (GPIO_ACTIVE_HIGH)>,
                            <&gpio0 9   (GPIO_ACTIVE_HIGH)>,
                            <&gpio1 7   (GPIO_ACTIVE_HIGH)>;
        col-gpios       =   <&gpio0 31  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 29  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 2   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 15  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 13  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 11  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 2   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 1   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 4   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 11  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 24  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 22  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 20  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 17  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    mtx0: matrix_transform {
        compatible      =   "zmk,matrix-transform";
        rows            =   <6>;
        columns         =   <14>;
        map             =   <
                                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
                                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
                                RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                                RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)      RC(3,12)
                                    RC(4,0)     RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
                                RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)         RC(5,6)         RC(5,8) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13)
        >;
    };

    phlo0: physical-layout {
        compatible      =   "zmk,physical-layout";
        display-name    =   "Default Layout";
        kscan           =   <&kscan0>;
        transform       =   <&mtx0>;
        keys            =   <&key_physical_attrs 100 100 0 0 0 0 0>,    <&key_physical_attrs 100 100 106 0 0 0 0>,      <&key_physical_attrs 100 100 212 0 0 0 0>,      <&key_physical_attrs 100 100 318 0 0 0 0>,      <&key_physical_attrs 100 100 424 0 0 0 0>,      <&key_physical_attrs 100 100 530 0 0 0 0>,      <&key_physical_attrs 100 100 636 0 0 0 0>,      <&key_physical_attrs 100 100 742 0 0 0 0>,      <&key_physical_attrs 100 100 848 0 0 0 0>,      <&key_physical_attrs 100 100 954 0 0 0 0>,      <&key_physical_attrs 100 100 1060 0 0 0 0>,     <&key_physical_attrs 100 100 1166 0 0 0 0>,     <&key_physical_attrs 100 100 1272 0 0 0 0>,     <&key_physical_attrs 100 100 1378 0 0 0 0>,
                            <&key_physical_attrs 100 100 0 106 0 0 0>,  <&key_physical_attrs 100 100 106 106 0 0 0>,    <&key_physical_attrs 100 100 212 106 0 0 0>,    <&key_physical_attrs 100 100 318 106 0 0 0>,    <&key_physical_attrs 100 100 424 106 0 0 0>,    <&key_physical_attrs 100 100 530 106 0 0 0>,    <&key_physical_attrs 100 100 636 106 0 0 0>,    <&key_physical_attrs 100 100 742 106 0 0 0>,    <&key_physical_attrs 100 100 848 106 0 0 0>,    <&key_physical_attrs 100 100 954 106 0 0 0>,    <&key_physical_attrs 100 100 1060 106 0 0 0>,   <&key_physical_attrs 100 100 1166 106 0 0 0>,   <&key_physical_attrs 100 100 1272 106 0 0 0>,   <&key_physical_attrs 100 100 1378 106 0 0 0>,
                            <&key_physical_attrs 100 100 0 212 0 0 0>,  <&key_physical_attrs 100 100 106 212 0 0 0>,    <&key_physical_attrs 100 100 212 212 0 0 0>,    <&key_physical_attrs 100 100 318 212 0 0 0>,    <&key_physical_attrs 100 100 424 212 0 0 0>,    <&key_physical_attrs 100 100 530 212 0 0 0>,    <&key_physical_attrs 100 100 636 212 0 0 0>,    <&key_physical_attrs 100 100 742 212 0 0 0>,    <&key_physical_attrs 100 100 848 212 0 0 0>,    <&key_physical_attrs 100 100 954 212 0 0 0>,    <&key_physical_attrs 100 100 1060 212 0 0 0>,   <&key_physical_attrs 100 100 1166 212 0 0 0>,   <&key_physical_attrs 100 100 1272 212 0 0 0>,   <&key_physical_attrs 100 100 1378 212 0 0 0>,
                            <&key_physical_attrs 100 100 0 318 0 0 0>,  <&key_physical_attrs 100 100 106 318 0 0 0>,    <&key_physical_attrs 100 100 212 318 0 0 0>,    <&key_physical_attrs 100 100 318 318 0 0 0>,    <&key_physical_attrs 100 100 424 318 0 0 0>,    <&key_physical_attrs 100 100 530 318 0 0 0>,    <&key_physical_attrs 100 100 636 318 0 0 0>,    <&key_physical_attrs 100 100 742 318 0 0 0>,    <&key_physical_attrs 100 100 848 318 0 0 0>,    <&key_physical_attrs 100 100 954 318 0 0 0>,    <&key_physical_attrs 100 100 1060 318 0 0 0>,   <&key_physical_attrs 100 100 1166 318 0 0 0>,                        <&key_physical_attrs 206 100 1272 318 0 0 0>,
                                                 <&key_physical_attrs 206 100 0 424 0 0 0>,                             <&key_physical_attrs 100 100 212 424 0 0 0>,    <&key_physical_attrs 100 100 318 424 0 0 0>,    <&key_physical_attrs 100 100 424 424 0 0 0>,    <&key_physical_attrs 100 100 530 424 0 0 0>,    <&key_physical_attrs 100 100 636 424 0 0 0>,    <&key_physical_attrs 100 100 742 424 0 0 0>,    <&key_physical_attrs 100 100 848 424 0 0 0>,    <&key_physical_attrs 100 100 954 424 0 0 0>,    <&key_physical_attrs 100 100 1060 424 0 0 0>,   <&key_physical_attrs 100 100 1166 424 0 0 0>,   <&key_physical_attrs 100 100 1272 424 0 0 0>,   <&key_physical_attrs 100 100 1378 424 0 0 0>,
                            <&key_physical_attrs 100 100 0 530 0 0 0>,  <&key_physical_attrs 100 100 106 530 0 0 0>,    <&key_physical_attrs 100 100 212 530 0 0 0>,    <&key_physical_attrs 100 100 318 530 0 0 0>,    <&key_physical_attrs 100 100 424 530 0 0 0>,                                                    <&key_physical_attrs 312 100 530 530 0 0 0>,                                                    <&key_physical_attrs 100 100 848 530 0 0 0>,    <&key_physical_attrs 100 100 954 530 0 0 0>,    <&key_physical_attrs 100 100 1060 530 0 0 0>,   <&key_physical_attrs 100 100 1166 530 0 0 0>,   <&key_physical_attrs 100 100 1272 530 0 0 0>,   <&key_physical_attrs 100 100 1378 530 0 0 0>;
    };
};
