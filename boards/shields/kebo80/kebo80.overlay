#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout     = &phlo0;
    };

    kscan0: kscan {
        compatible      =   "zmk,kscan-gpio-matrix";
        diode-direction =   "row2col";
        row-gpios       =   <&gpio0 17 GPIO_ACTIVE_HIGH>,
                            <&gpio0 20 GPIO_ACTIVE_HIGH>,
                            <&gpio0 22 GPIO_ACTIVE_HIGH>,
                            <&gpio0 24 GPIO_ACTIVE_HIGH>,
                            <&gpio1 0  GPIO_ACTIVE_HIGH>,
                            <&gpio0 11 GPIO_ACTIVE_HIGH>;
        col-gpios       =   <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                            <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    mtx0: matrix_transform {
        compatible      =   "zmk,matrix-transform";
        rows            =   <6>;
        columns         =   <14>;
        map             =   <
                                RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
                                RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
                                RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
                                RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
                                RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
                                RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13)
        >;
    };

    phlo0: physical-layout {
        compatible      =   "zmk,physical-layout";
        display-name    =   "Default Layout";
        kscan           =   <&kscan0>;
        transform       =   <&mtx0>;
        keys            =   <&key_physical_attrs 19 19 0 0 0 0 0>,  <&key_physical_attrs 19 19 19 0 0 0 0>,  <&key_physical_attrs 19 19 38 0 0 0 0>,  <&key_physical_attrs 19 19 57 0 0 0 0>,  <&key_physical_attrs 19 19 76 0 0 0 0>,  <&key_physical_attrs 19 19 95 0 0 0 0>,  <&key_physical_attrs 19 19 114 0 0 0 0>,  <&key_physical_attrs 19 19 133 0 0 0 0>,  <&key_physical_attrs 19 19 152 0 0 0 0>,  <&key_physical_attrs 19 19 171 0 0 0 0>,  <&key_physical_attrs 19 19 190 0 0 0 0>,  <&key_physical_attrs 19 19 209 0 0 0 0>,  <&key_physical_attrs 19 19 228 0 0 0 0>,  <&key_physical_attrs 19 19 247 0 0 0 0>,
                            <&key_physical_attrs 19 19 0 19 0 0 0>, <&key_physical_attrs 19 19 19 19 0 0 0>, <&key_physical_attrs 19 19 38 19 0 0 0>, <&key_physical_attrs 19 19 57 19 0 0 0>, <&key_physical_attrs 19 19 76 19 0 0 0>, <&key_physical_attrs 19 19 95 19 0 0 0>, <&key_physical_attrs 19 19 114 19 0 0 0>, <&key_physical_attrs 19 19 133 19 0 0 0>, <&key_physical_attrs 19 19 152 19 0 0 0>, <&key_physical_attrs 19 19 171 19 0 0 0>, <&key_physical_attrs 19 19 190 19 0 0 0>, <&key_physical_attrs 19 19 209 19 0 0 0>, <&key_physical_attrs 19 19 228 19 0 0 0>, <&key_physical_attrs 19 19 247 19 0 0 0>,
                            <&key_physical_attrs 19 19 0 38 0 0 0>, <&key_physical_attrs 19 19 19 38 0 0 0>, <&key_physical_attrs 19 19 38 38 0 0 0>, <&key_physical_attrs 19 19 57 38 0 0 0>, <&key_physical_attrs 19 19 76 38 0 0 0>, <&key_physical_attrs 19 19 95 38 0 0 0>, <&key_physical_attrs 19 19 114 38 0 0 0>, <&key_physical_attrs 19 19 133 38 0 0 0>, <&key_physical_attrs 19 19 152 38 0 0 0>, <&key_physical_attrs 19 19 171 38 0 0 0>, <&key_physical_attrs 19 19 190 38 0 0 0>, <&key_physical_attrs 19 19 209 38 0 0 0>, <&key_physical_attrs 19 19 228 38 0 0 0>, <&key_physical_attrs 19 19 247 38 0 0 0>,
                            <&key_physical_attrs 19 19 0 57 0 0 0>, <&key_physical_attrs 19 19 19 57 0 0 0>, <&key_physical_attrs 19 19 38 57 0 0 0>, <&key_physical_attrs 19 19 57 57 0 0 0>, <&key_physical_attrs 19 19 76 57 0 0 0>, <&key_physical_attrs 19 19 95 57 0 0 0>, <&key_physical_attrs 19 19 114 57 0 0 0>, <&key_physical_attrs 19 19 133 57 0 0 0>, <&key_physical_attrs 19 19 152 57 0 0 0>, <&key_physical_attrs 19 19 171 57 0 0 0>, <&key_physical_attrs 19 19 190 57 0 0 0>, <&key_physical_attrs 19 19 209 57 0 0 0>, <&key_physical_attrs 19 19 228 57 0 0 0>, <&key_physical_attrs 19 19 247 57 0 0 0>,
                            <&key_physical_attrs 19 19 0 76 0 0 0>, <&key_physical_attrs 19 19 19 76 0 0 0>, <&key_physical_attrs 19 19 38 76 0 0 0>, <&key_physical_attrs 19 19 57 76 0 0 0>, <&key_physical_attrs 19 19 76 76 0 0 0>, <&key_physical_attrs 19 19 95 76 0 0 0>, <&key_physical_attrs 19 19 114 76 0 0 0>, <&key_physical_attrs 19 19 133 76 0 0 0>, <&key_physical_attrs 19 19 152 76 0 0 0>, <&key_physical_attrs 19 19 171 76 0 0 0>, <&key_physical_attrs 19 19 190 76 0 0 0>, <&key_physical_attrs 19 19 209 76 0 0 0>, <&key_physical_attrs 19 19 228 76 0 0 0>, <&key_physical_attrs 19 19 247 76 0 0 0>,
                            <&key_physical_attrs 19 19 0 95 0 0 0>, <&key_physical_attrs 19 19 19 95 0 0 0>, <&key_physical_attrs 19 19 38 95 0 0 0>, <&key_physical_attrs 19 19 57 95 0 0 0>, <&key_physical_attrs 19 19 76 95 0 0 0>, <&key_physical_attrs 19 19 95 95 0 0 0>, <&key_physical_attrs 19 19 114 95 0 0 0>, <&key_physical_attrs 19 19 133 95 0 0 0>, <&key_physical_attrs 19 19 152 95 0 0 0>, <&key_physical_attrs 19 19 171 95 0 0 0>, <&key_physical_attrs 19 19 190 95 0 0 0>, <&key_physical_attrs 19 19 209 95 0 0 0>, <&key_physical_attrs 19 19 228 95 0 0 0>, <&key_physical_attrs 19 19 247 95 0 0 0>;
    };
};
